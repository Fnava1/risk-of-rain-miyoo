FROM aemiii91/miyoomini-toolchain:latest

ENV PATH="/opt/miyoomini-toolchain/usr/bin:${PATH}:/opt/miyoomini-toolchain/usr/arm-linux-gnueabihf/sysroot/bin"
ENV CROSS_COMPILE=/opt/miyoomini-toolchain/usr/bin/arm-linux-gnueabihf-
ENV PREFIX=/opt/miyoomini-toolchain/usr/arm-linux-gnueabihf/sysroot/usr
ENV UNION_PLATFORM=miyoomini

WORKDIR /work

ENTRYPOINT ["/bin/bash"]
